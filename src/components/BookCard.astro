---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { statusLabel, statusClasses, sectionWord, type Status } from "../lib/display";
import { sourceUrl as buildSourceUrl } from "../site.config";

interface Props {
  entry: CollectionEntry<"notes">;
}

const { entry } = Astro.props;
const d = entry.data;
const href = `/notes/${entry.id}`;
const status = d.status as Status;
const sourceUrl = d.repo ? buildSourceUrl(d.repo, d.sourcePath, d.repoBranch) : null;
const sourcePath = d.sourcePath ?? "README.md";

// Real signal: how many chapters/modules have notes completed.
const totalSections = d.sections.length;
const doneSections = d.sections.filter((s) => s.done).length;
const kind = sectionWord(d.type);

// Data attributes power the client-side search/filter on the index page.
const searchBlob = [
  d.title,
  d.author,
  d.category,
  d.summary,
  ...d.tags,
  ...d.sections.flatMap((s) => [s.title, s.note, s.meta]),
]
  .filter(Boolean)
  .join(" ")
  .toLowerCase();
---

<article
  class="book-card group flex flex-col bg-surface-container-low border border-surface-container-highest rounded-lg p-space-md transition-colors hover:border-outline-variant"
  data-search={searchBlob}
  data-status={status}
  data-category={d.category.toLowerCase()}
>
  {/* Top rule: category + section completion */}
  <div class="flex items-start justify-between gap-space-sm">
    <span class="font-mono text-[11px] uppercase tracking-wider text-secondary flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
      {d.category}
    </span>
    {
      totalSections > 0 && (
        <span
          class="font-mono text-[11px] text-on-surface-variant whitespace-nowrap"
          title={`${doneSections} of ${totalSections} ${kind.toLowerCase()} synthesized`}
        >
          {doneSections}/{totalSections} {kind.toLowerCase()}
        </span>
      )
    }
  </div>

  {/* Title + author with cover thumbnail */}
  <a href={href} class="mt-space-sm flex gap-space-sm items-start">
    {
      d.cover ? (
        <Image
          src={d.cover}
          alt={d.coverAlt ?? d.title}
          width={56}
          height={80}
          class="w-14 h-20 shrink-0 object-cover rounded border border-surface-container-highest"
        />
      ) : (
        <div class="w-14 h-20 shrink-0 rounded bg-surface-container-high border border-surface-container-highest flex items-center justify-center">
          <span class="material-symbols-outlined text-on-surface-variant text-[22px]">
            {d.type === "course" ? "school" : "menu_book"}
          </span>
        </div>
      )
    }
    <div class="min-w-0">
      <h3 class="font-serif text-xl leading-snug text-on-surface group-hover:text-terracotta transition-colors">
        {d.title}
      </h3>
      {
        d.author && (
          <p class="font-serif italic text-sm text-on-surface-variant mt-0.5">
            {d.author}
            {d.year ? ` · ${d.year}` : ""}
          </p>
        )
      }
    </div>
  </a>

  {/* Summary */}
  {
    d.summary && (
      <p class="font-serif text-[15px] leading-relaxed text-on-surface-variant mt-space-sm line-clamp-3">
        {d.summary}
      </p>
    )
  }

  {/* Progress bar (reading) */}
  {
    status === "reading" && (
      <div class="mt-space-md">
        <div class="flex items-center justify-between font-mono text-[11px] text-on-surface-variant mb-1">
          <span class="uppercase tracking-wider">{d.progress}% in flight</span>
          {d.pages && d.currentPage && (
            <span>
              p. {d.currentPage} / {d.pages}
            </span>
          )}
        </div>
        <div class="h-[3px] w-full bg-surface-container-highest rounded-full overflow-hidden">
          <div
            class="h-full bg-secondary"
            style={`width: ${d.progress}%`}
          />
        </div>
      </div>
    )
  }

  {/* Lower shelf: source link + status */}
  <div class="mt-space-md pt-space-sm border-t border-surface-container-highest flex items-center justify-between gap-space-sm">
    <a
      href={sourceUrl ?? href}
      target={sourceUrl ? "_blank" : undefined}
      rel={sourceUrl ? "noreferrer" : undefined}
      class="inline-flex items-center gap-1.5 font-mono text-[12px] text-secondary hover:underline underline-offset-2 truncate"
    >
      <span class="material-symbols-outlined text-[14px]">code</span>
      {sourcePath}
    </a>
    <span
      class:list={[
        "shrink-0 px-space-xs py-0.5 rounded font-mono text-[10px] uppercase tracking-wider font-medium",
        statusClasses(status),
      ]}
    >
      {statusLabel(status)}
    </span>
  </div>
</article>
