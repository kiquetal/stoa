---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BookCard from "../components/BookCard.astro";

const all = await getCollection("notes");

// Sort: reading first, then by manual order / title.
const statusRank: Record<string, number> = {
  reading: 0,
  planned: 1,
  reference: 2,
  completed: 3,
};
all.sort((a, b) => {
  const s = statusRank[a.data.status] - statusRank[b.data.status];
  if (s !== 0) return s;
  if (a.data.order != null && b.data.order != null)
    return a.data.order - b.data.order;
  return a.data.title.localeCompare(b.data.title);
});

const reading = all.filter((e) => e.data.status === "reading");
const completed = all.filter((e) => e.data.status === "completed");
const techCount = all.filter((e) =>
  e.data.category.toLowerCase().includes("tech"),
).length;

// Distinct tags for the index tag strip.
const tagSet = new Set<string>();
for (const e of all) for (const t of e.data.tags) tagSet.add(t);
const tags = [...tagSet].sort();

const totalWordsAvg = 1420; // decorative leaf metric
---

<BaseLayout variant="catalog" title="Curator's Index — Reading & Course Ledger">
  <main class="w-full bg-surface">
    <div class="max-w-catalog mx-auto w-full px-gutter-mobile lg:px-gutter-desktop py-space-xl">
      {/* Ledger intro */}
      <section class="pb-space-xl">
        <div class="max-w-reading space-y-space-xs">
          <div class="flex items-center gap-space-xs text-secondary font-mono text-[11px] uppercase tracking-widest">
            <span class="inline-block w-2 h-2 rounded-full bg-secondary"></span>
            <span>Digital Commonplace &amp; Study Ledger</span>
          </div>
          <h1 class="font-serif text-4xl md:text-5xl leading-tight tracking-tight text-on-surface">
            Curator's Index &amp; Reading Ledger
          </h1>
          <p class="font-serif italic text-lg leading-relaxed text-on-surface-variant">
            An archival ledger of ongoing intellectual inquiries — book and
            course notes spanning systems, engineering, and literature. Bound
            directly to local Markdown flat-files.
          </p>
        </div>
      </section>

      {/* Metrics ribbon (derived from real content) */}
      <section class="grid grid-cols-2 md:grid-cols-4 gap-space-sm pb-space-2xl">
        <div class="bg-surface-container-low p-space-md rounded-xl border border-surface-container-highest flex flex-col justify-between">
          <span class="font-mono text-[11px] uppercase text-outline tracking-wider">Active Reads</span>
          <div class="pt-space-xs flex items-baseline gap-space-xs">
            <span class="font-serif text-2xl font-semibold text-on-surface">{reading.length}</span>
            <span class="font-mono text-[11px] text-secondary">in flight</span>
          </div>
        </div>
        <div class="bg-surface-container-low p-space-md rounded-xl border border-surface-container-highest flex flex-col justify-between">
          <span class="font-mono text-[11px] uppercase text-outline tracking-wider">Vault Leaves</span>
          <div class="pt-space-xs flex items-baseline gap-space-xs">
            <span class="font-serif text-2xl font-semibold text-on-surface">{all.length}</span>
            <span class="font-mono text-[11px] text-on-surface-variant">volumes</span>
          </div>
        </div>
        <div class="bg-surface-container-low p-space-md rounded-xl border border-surface-container-highest flex flex-col justify-between">
          <span class="font-mono text-[11px] uppercase text-outline tracking-wider">Completed</span>
          <div class="pt-space-xs flex items-baseline gap-space-xs">
            <span class="font-serif text-2xl font-semibold text-on-surface">{completed.length}</span>
            <span class="font-mono text-[11px] text-on-tertiary-container">archived</span>
          </div>
        </div>
        <div class="bg-surface-container-low p-space-md rounded-xl border border-surface-container-highest flex flex-col justify-between">
          <span class="font-mono text-[11px] uppercase text-outline tracking-wider">Discipline Ratio</span>
          <div class="pt-space-xs flex items-baseline gap-space-xs">
            <span class="font-serif text-2xl font-semibold text-on-surface">{techCount} Tech</span>
            <span class="font-mono text-[11px] text-on-surface-variant">{all.length - techCount} other</span>
          </div>
        </div>
      </section>

      {/* Currently reading desks */}
      {
        reading.length > 0 && (
          <section id="reading" class="pb-space-2xl">
            <div class="flex items-baseline justify-between mb-space-md">
              <h2 class="font-serif text-2xl text-on-surface">
                Currently Reading{" "}
                <span class="font-serif italic text-base text-on-surface-variant">
                  · active desks
                </span>
              </h2>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-space-md">
              {reading.map((e) => (
                <a
                  href={`/notes/${e.id}`}
                  class="group block bg-surface-container-low border border-surface-container-highest rounded-lg p-space-lg hover:border-outline-variant transition-colors"
                >
                  <div class="flex items-center justify-between font-mono text-[11px] uppercase tracking-wider">
                    <span class="px-space-xs py-0.5 rounded bg-moss-deep text-moss-pale">
                      {e.data.category}
                    </span>
                    <span class="text-secondary">{e.data.progress}% finished</span>
                  </div>
                  <h3 class="font-serif text-2xl mt-space-sm text-on-surface group-hover:text-terracotta transition-colors">
                    {e.data.title}
                  </h3>
                  {e.data.author && (
                    <p class="font-serif italic text-sm text-on-surface-variant">
                      by {e.data.author}
                      {e.data.year ? ` · ${e.data.year}` : ""}
                    </p>
                  )}
                  {e.data.pages && e.data.currentPage && (
                    <p class="font-mono text-[11px] text-on-surface-variant mt-space-sm">
                      Page {e.data.currentPage} of {e.data.pages}
                    </p>
                  )}
                  <div class="h-[3px] w-full bg-surface-container-highest rounded-full overflow-hidden mt-1.5">
                    <div class="h-full bg-secondary" style={`width: ${e.data.progress}%`} />
                  </div>
                  {e.data.anchor && (
                    <div class="mt-space-md bg-surface-container-high border border-surface-container-highest rounded p-space-sm">
                      {e.data.anchor.label && (
                        <span class="font-mono text-[10px] uppercase tracking-wider text-secondary">
                          {e.data.anchor.label}
                        </span>
                      )}
                      <p class="font-serif italic text-sm text-on-surface-variant mt-1">
                        "{e.data.anchor.text}"
                      </p>
                    </div>
                  )}
                  <div class="mt-space-md flex items-center gap-1.5 font-mono text-[12px] text-secondary">
                    <span class="material-symbols-outlined text-[14px]">code</span>
                    {e.data.repoPath ?? `notes/${e.id}.md`}
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }

      {/* Catalog: filter tabs + search + grid */}
      <section id="catalog">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-sm mb-space-md">
          <div id="filter-tabs" class="flex items-center gap-space-xs flex-wrap font-mono text-[11px] uppercase tracking-wider">
            <button data-filter="all" class="filter-tab is-active px-space-sm py-1 rounded">All Entries ({all.length})</button>
            <button data-filter="reading" class="filter-tab px-space-sm py-1 rounded">Reading ({reading.length})</button>
            <button data-filter="completed" class="filter-tab px-space-sm py-1 rounded">Finished ({completed.length})</button>
            <button data-filter="reference" class="filter-tab px-space-sm py-1 rounded">Reference</button>
          </div>
          <div class="relative flex items-center md:w-64">
            <span class="material-symbols-outlined absolute left-space-xs text-on-surface-variant text-[16px] pointer-events-none">search</span>
            <input
              id="catalog-search"
              type="text"
              placeholder="Search volumes..."
              class="w-full pl-7 pr-space-xs py-1 text-[13px] font-mono bg-surface-container rounded border border-surface-container-highest text-on-surface placeholder:text-on-surface-variant focus:outline-none focus:bg-surface-container-lowest"
            />
          </div>
        </div>

        {
          tags.length > 0 && (
            <div class="flex items-center gap-space-xs flex-wrap mb-space-lg font-mono text-[12px]">
              {tags.map((t) => (
                <span class="text-secondary">#{t}</span>
              ))}
            </div>
          )
        }

        <div id="catalog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-md">
          {all.map((entry) => <BookCard entry={entry} />)}
        </div>
        <p id="no-results" class="hidden py-space-2xl text-center font-serif italic text-on-surface-variant">
          No volumes match your search.
        </p>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .filter-tab {
    color: #44474a;
    transition: all 0.15s;
  }
  .filter-tab:hover {
    color: #1d1b19;
  }
  .filter-tab.is-active {
    background: #1e2022;
    color: #fef8f3;
  }
</style>

<script>
  const grid = document.getElementById("catalog-grid");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".book-card"));
  const search = document.getElementById("catalog-search") as HTMLInputElement | null;
  const globalSearch = document.getElementById("global-search") as HTMLInputElement | null;
  const tabs = Array.from(document.querySelectorAll<HTMLElement>(".filter-tab"));
  const noResults = document.getElementById("no-results");

  let activeFilter = "all";
  let query = "";

  function apply() {
    let visible = 0;
    for (const card of cards) {
      const status = card.dataset.status ?? "";
      const blob = card.dataset.search ?? "";
      const matchesFilter = activeFilter === "all" || status === activeFilter;
      const matchesQuery = query === "" || blob.includes(query);
      const show = matchesFilter && matchesQuery;
      card.style.display = show ? "" : "none";
      if (show) visible++;
    }
    if (noResults) noResults.classList.toggle("hidden", visible !== 0);
    if (grid) grid.classList.toggle("hidden", visible === 0);
  }

  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      tabs.forEach((t) => t.classList.remove("is-active"));
      tab.classList.add("is-active");
      activeFilter = tab.dataset.filter ?? "all";
      apply();
    });
  }

  function onSearch(v: string) {
    query = v.trim().toLowerCase();
    apply();
  }
  search?.addEventListener("input", (e) => onSearch((e.target as HTMLInputElement).value));
  globalSearch?.addEventListener("input", (e) => onSearch((e.target as HTMLInputElement).value));
</script>
